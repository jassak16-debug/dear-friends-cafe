# Copy to .env.local for local testing; set the same values in Vercel for production.

# Public URL of the live site (canonical links, sitemap, social previews)
SITE_URL=https://www.your-domain.co.nz

# Show yellow boxes marking missing client content (default: hidden)
SHOW_PLACEHOLDERS=false

# Force search engines out (the site is noindex anyway while SITE_URL is unset)
NOINDEX=

# Online booking master switch: requests are only stored when this is true
# AND the Supabase keys below are set. Leave off for the demo.
ONLINE_BOOKINGS=

# Supabase (server-side only; never prefix with NEXT_PUBLIC_ or expose to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: only accept form posts from this origin
ALLOWED_ORIGIN=
